<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>Payment Details - Nexora Capital</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #050817;
            background-image: radial-gradient(ellipse at 50% 18%, rgba(27, 69, 112, .28), transparent 42%),
                radial-gradient(ellipse at 20% 75%, rgba(219, 49, 119, .12), transparent 35%),
                radial-gradient(ellipse at 85% 88%, rgba(25, 113, 184, .14), transparent 38%);
            color: #f1f5ff;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .mobile-frame {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: linear-gradient(180deg, rgba(8, 14, 31, .98), rgba(5, 9, 23, .98));
            padding: 20px 16px 40px;
            position: relative;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(115, 199, 255, .08);
            border-right: 1px solid rgba(115, 199, 255, .08);
        }

        .screen-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .back-btn {
            font-size: 16px;
            color: #8ff1ff;
            text-decoration: none;
            width: 38px;
            height: 38px;
            background: rgba(8, 18, 39, .85);
            border: 1.5px solid #72e8ff;
            border-radius: 50%;
            display: grid;
            place-items: center;
            box-shadow: 0 0 16px rgba(68, 213, 255, .13);
        }

        .header-title {
            font-size: 20px;
            font-weight: 900;
            color: #eaf7ff;
            text-shadow: 0 0 12px rgba(91, 202, 255, .35);
        }

        .details-card {
            background: linear-gradient(145deg, rgba(23, 34, 59, .96), rgba(10, 17, 36, .96));
            border: 1.5px solid rgba(185, 218, 255, .4);
            border-radius: 20px;
            padding: 16px 18px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
        }

        .bank-logo {
            width: 44px;
            height: 44px;
            object-fit: contain;
            border-radius: 12px;
            border: 1px solid rgba(187, 220, 255, .3);
            padding: 4px;
            background: #ffffff;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .input-box-custom {
            background: rgba(13, 22, 43, 0.9);
            border: 1.5px solid rgba(187, 220, 255, .3);
            border-radius: 16px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
        }

        .input-box-custom input {
            width: 100%;
            border: 0;
            outline: none;
            background: transparent;
            font-size: 13px;
            font-weight: 700;
            color: #f8fafc;
        }

        .upload-box {
            border: 2px dashed rgba(185, 218, 255, .4);
            padding: 24px 20px;
            border-radius: 20px;
            text-align: center;
            cursor: pointer;
            background: linear-gradient(145deg, rgba(23, 34, 59, .7), rgba(10, 17, 36, .85));
            margin-bottom: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        .btn-gradient {
            display: block;
            width: 100%;
            padding: 14px;
            border-radius: 25px;
            background: linear-gradient(145deg, #14b8a6, #047857);
            color: #fff;
            border: 1px solid rgba(161, 255, 225, .5);
            font-size: 15px;
            font-weight: 900;
            cursor: pointer;
            text-transform: uppercase;
            box-shadow: 0 10px 25px rgba(20, 184, 166, 0.4), inset 0 2px 3px rgba(255, 255, 255, 0.4);
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
        }
    </style>
</head>

<body>
    <div class="mobile-frame">
        <div class="screen-header">
            <a href="/invest" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h2 class="header-title">Payment Details</h2>
                <div style="font-size: 11px; color: #b7c4d9; font-weight: 600;">Send payment, then submit receipt.</div>
            </div>
        </div>

        <div class="details-card">
            <div style="display: flex; align-items: center; gap: 12px;">
                <img src="<%= bank.logo %>" class="bank-logo" alt="<%= bank.bankName %>"
                    onerror="this.src='/assets/Easypaisa-logo.png'">
                <strong style="color: #f8fafc; font-size: 16px;">
                    <%= bank.bankName %>
                </strong>
            </div>
            <div style="text-align: right;">
                <small
                    style="font-size: 10px; color: #b7c4d9; display: block; text-transform: uppercase; font-weight: 700;">Amount</small>
                <strong style="color: #ff5c77; font-size: 16px; text-shadow: 0 0 10px rgba(255, 92, 119, 0.4);">Rs. <%=
                        pkg.price %></strong>
            </div>
        </div>

        <div class="details-card">
            <div>
                <small style="color: #b7c4d9; font-size: 11px; text-transform: uppercase; font-weight: 700;">Account
                    Holder</small>
                <strong style="font-size: 14px; display: block; color: #f8fafc; margin-top: 2px;">
                    <%= bank.accountTitle %>
                </strong>
            </div>
            <button type="button" onclick="navigator.clipboard.writeText('<%= bank.accountTitle %>')"
                style="background: rgba(20, 184, 166, 0.2); border: 1px solid rgba(20, 184, 166, 0.4); width: 36px; height: 36px; border-radius: 50%; color: #34d399; cursor: pointer; display: grid; place-items: center; font-size: 14px;"><i
                    class="fa-regular fa-copy"></i></button>
        </div>

        <div class="details-card">
            <div>
                <small style="color: #b7c4d9; font-size: 11px; text-transform: uppercase; font-weight: 700;">Account
                    Number</small>
                <strong style="font-size: 14px; display: block; color: #f8fafc; margin-top: 2px;">
                    <%= bank.accountNumber %>
                </strong>
            </div>
            <button type="button" onclick="navigator.clipboard.writeText('<%= bank.accountNumber %>')"
                style="background: rgba(20, 184, 166, 0.2); border: 1px solid rgba(20, 184, 166, 0.4); width: 36px; height: 36px; border-radius: 50%; color: #34d399; cursor: pointer; display: grid; place-items: center; font-size: 14px;"><i
                    class="fa-regular fa-copy"></i></button>
        </div>

        <form action="/submit-payment" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="packageId" value="<%= pkg.id %>">
            <input type="hidden" name="bankId" value="<%= bank._id %>">

            <div class="input-box-custom">
                <i class="fa-regular fa-file-lines" style="color: #34d399;"></i>
                <input type="text" name="transactionId" required placeholder="Enter Transaction ID (TID)">
            </div>

            <div onclick="document.getElementById('ssFile').click()" class="upload-box">
                <div style="font-size: 24px; color: #34d399; margin-bottom: 6px;"><i
                        class="fa-solid fa-cloud-arrow-up"></i></div>
                <strong style="font-size: 14px; display: block; color: #f8fafc;">Upload Payment Screenshot</strong>
                <input type="file" id="ssFile" name="screenshot" accept="image/*" style="display: none;"
                    onchange="document.getElementById('fileName').innerText = this.files[0].name">
                <div id="fileName" style="font-size: 11px; color: #34d399; margin-top: 6px; font-weight: 600;">No file
                    selected</div>
            </div>

            <button type="submit" class="btn-gradient">Submit for Verification</button>
        </form>
    </div>
</body>

</html>