<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>Deposit History - Nexora Capital</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #fdf6ec;
            color: #1e293b;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .mobile-frame {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: #fef8f0;
            padding: 20px 16px 95px;
            position: relative;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        }

        .screen-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .back-btn {
            font-size: 20px;
            color: #0f172a;
            text-decoration: none;
            width: 36px;
            height: 36px;
            background: #fff;
            border: 1px solid #ffd79d;
            border-radius: 50%;
            display: grid;
            place-items: center;
        }

        .header-title {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
        }

        .card-box {
            background: #fff;
            border: 2px solid #ffd79d;
            border-radius: 20px;
            padding: 16px;
            margin-bottom: 14px;
            box-shadow: 0 4px 15px rgba(210, 135, 45, 0.06);
        }

        .deposit-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .deposit-item:last-child {
            border-bottom: none;
        }

        .badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .badge.pending {
            background: #fef3c7;
            color: #d97706;
        }

        .badge.approved {
            background: #dcfce7;
            color: #15803d;
        }

        .badge.rejected,
        .badge.canceled {
            background: #fee2e2;
            color: #b91c1c;
        }

        .bottom-nav {
            position: fixed;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            width: min(calc(100% - 24px), 396px);
            height: 62px;
            background: #fff;
            border: 2px solid #ffd79d;
            border-radius: 35px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
            z-index: 100;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #94a3b8;
            font-size: 10px;
            font-weight: 700;
        }

        .nav-item.active {
            color: #008069;
        }

        .nav-item i {
            font-size: 18px;
            margin-bottom: 2px;
        }

        .fab-center {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #008069;
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 20px;
            font-weight: 900;
            margin-top: -30px;
            border: 4px solid #fdf6ec;
            box-shadow: 0 4px 15px rgba(0, 128, 105, 0.4);
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="mobile-frame">
        <div class="screen-header">
            <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <h2 class="header-title">Deposit History</h2>
        </div>

        <div class="card-box">
            <% if (typeof deposits !=='undefined' && deposits.length> 0) { %>
                <% deposits.forEach(d=> { %>
                    <div class="deposit-item">
                        <div>
                            <div style="font-size: 13px; font-weight: 700; color: #0f172a;">Rs. <%=
                                    d.amount.toLocaleString() %>
                            </div>
                            <div style="font-size: 11px; color: #64748b;">
                                <%= d.method %> • Trx: <%= d.transactionId %>
                            </div>
                            <div style="font-size: 9px; color: #94a3b8;">
                                <%= new Date(d.date).toLocaleString() %>
                            </div>
                        </div>
                        <div>
                            <span class="badge <%= d.status.toLowerCase() %>">
                                <%= d.status %>
                            </span>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div style="text-align: center; padding: 30px; color: #94a3b8; font-size: 13px;">
                                <i class="fa-solid fa-folder-open" style="font-size: 28px; margin-bottom: 8px;"></i>
                                <p>Koi deposit record mojood nahi hai.</p>
                            </div>
                            <% } %>
        </div>

        <nav class="bottom-nav">
            <a href="/" class="nav-item"><i class="fa-solid fa-house"></i><span>Home</span></a>
            <a href="/invest" class="nav-item"><i class="fa-solid fa-chart-line"></i><span>Active</span></a>
            <a href="/invest" class="fab-center">N</a>
            <a href="/deposit-history" class="nav-item active"><i
                    class="fa-solid fa-building-columns"></i><span>Deposits</span></a>
            <a href="/profile" class="nav-item"><i class="fa-regular fa-user"></i><span>Profile</span></a>
        </nav>
    </div>
</body>

</html>