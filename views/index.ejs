<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>Nexora Capital - Welcome</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #fce8cc;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px 14px;
        }

        .screen-container {
            width: 100%;
            max-width: 380px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        /* Top Circular Badge */
        .brand-badge {
            width: 135px;
            height: 135px;
            background: #ffffff;
            border-radius: 50%;
            border: 4px solid #f6cf92;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 2;
            margin-bottom: -68px;
            box-shadow: 0 10px 25px rgba(220, 140, 50, 0.2);
            text-align: center;
        }

        .brand-badge-icon {
            font-size: 34px;
            color: #008069;
            margin-bottom: 3px;
            filter: drop-shadow(0 4px 8px rgba(0, 128, 105, 0.3));
        }

        .brand-badge-name {
            font-size: 13px;
            font-weight: 900;
            line-height: 1.1;
            color: #008069;
            letter-spacing: -0.3px;
        }

        .brand-badge-name span {
            color: #ff6b6b;
            display: block;
            font-size: 11px;
            letter-spacing: 0.5px;
        }

        /* Main Welcome Card */
        .welcome-card {
            width: 100%;
            background: #ffffff;
            border: 3px solid #f6cf92;
            border-radius: 36px;
            padding: 92px 24px 36px;
            text-align: center;
            box-shadow: 0 16px 36px rgba(210, 135, 45, 0.16);
            position: relative;
            z-index: 1;
        }

        .welcome-title {
            font-size: 38px;
            font-weight: 900;
            color: #e11d48;
            letter-spacing: -1px;
            line-height: 1.1;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .welcome-subtitle {
            font-size: 14px;
            font-weight: 500;
            color: #475569;
            line-height: 1.4;
            max-width: 220px;
            margin: 0 auto 32px;
        }

        /* Action Buttons */
        .actions-group {
            display: flex;
            flex-direction: column;
            gap: 14px;
            width: 100%;
        }

        .btn-create {
            display: block;
            width: 100%;
            padding: 15px 20px;
            border-radius: 30px;
            background: linear-gradient(90deg, #ff6b6b 0%, #ff8e53 100%);
            color: #ffffff;
            font-size: 17px;
            font-weight: 800;
            text-decoration: none;
            border: none;
            cursor: pointer;
            box-shadow: 0 8px 22px rgba(255, 107, 107, 0.38);
            transition: transform 0.15s ease;
        }

        .btn-create:active {
            transform: scale(0.98);
        }

        .btn-login {
            display: block;
            width: 100%;
            padding: 14px 20px;
            border-radius: 30px;
            background: #ffffff;
            color: #008069;
            font-size: 17px;
            font-weight: 800;
            text-decoration: none;
            border: 2.5px solid #008069;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(0, 128, 105, 0.1);
            transition: transform 0.15s ease, background-color 0.15s ease;
        }

        .btn-login:active {
            transform: scale(0.98);
            background: #f0fdf9;
        }
    </style>
</head>

<body>

    <div class="screen-container">
        <!-- Top Circular Logo Badge -->
        <div class="brand-badge">
            <i class="fa-solid fa-chart-line brand-badge-icon"></i>
            <div class="brand-badge-name">
                NEXORA
                <span>CAPITAL</span>
            </div>
        </div>

        <!-- Main Welcome Card -->
        <div class="welcome-card">
            <h1 class="welcome-title">WELCOME</h1>
            <p class="welcome-subtitle">Get started with your account</p>

            <div class="actions-group">
                <a href="/signup" class="btn-create">Create Account</a>
                <a href="/login" class="btn-login">Login</a>
            </div>
        </div>
    </div>

</body>

</html>