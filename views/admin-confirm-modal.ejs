<style>
    .global-confirm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
        z-index: 99999;
        place-items: center;
        padding: 16px;
    }

    .global-confirm-overlay.active {
        display: grid;
    }

    .global-confirm-box {
        background: #ffffff;
        border-radius: 20px;
        width: 100%;
        max-width: 400px;
        padding: 24px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
        text-align: center;
    }

    .global-confirm-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #fee2e2;
        color: #dc2626;
        display: grid;
        place-items: center;
        font-size: 24px;
        margin: 0 auto 16px;
    }

    .global-confirm-box h3 {
        font-size: 18px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .global-confirm-box p {
        font-size: 13px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 22px;
    }

    .global-confirm-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .btn-global-cancel {
        flex: 1;
        background: #f1f5f9;
        color: #475569;
        border: none;
        padding: 11px 16px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-global-cancel:hover {
        background: #e2e8f0;
    }

    .btn-global-confirm {
        flex: 1;
        background: #dc2626;
        color: #ffffff;
        border: none;
        padding: 11px 16px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
    }

    .btn-global-confirm:hover {
        background: #b91c1c;
    }
</style>

<div class="global-confirm-overlay" id="globalConfirmOverlay">
    <div class="global-confirm-box">
        <div class="global-confirm-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h3 id="globalConfirmTitle">Are you sure?</h3>
        <p id="globalConfirmMessage">Do you really want to proceed with this action? This cannot be undone.</p>
        <div class="global-confirm-actions" id="globalConfirmActions">
            <button type="button" class="btn-global-cancel" id="globalCancelBtn"
                onclick="cancelGlobalConfirm()">Cancel</button>
            <button type="button" class="btn-global-confirm" id="globalConfirmOkBtn"
                onclick="executeGlobalConfirm()">Confirm</button>
        </div>
    </div>
</div>

<script>
    let pendingConfirmForm = null;
    let isAlertMode = false;

    document.addEventListener('DOMContentLoaded', function () {
        document.body.addEventListener('submit', function (e) {
            const form = e.target;
            if (form && form.hasAttribute('data-confirm')) {
                e.preventDefault();
                pendingConfirmForm = form;
                isAlertMode = false;
                document.getElementById('globalConfirmTitle').textContent = form.getAttribute('data-confirm-title') || 'Confirm Action';
                document.getElementById('globalConfirmMessage').textContent = form.getAttribute('data-confirm') || 'Are you sure?';
                document.getElementById('globalConfirmOkBtn').textContent = form.getAttribute('data-confirm-btn') || 'Proceed';
                document.getElementById('globalCancelBtn').style.display = 'block';
                document.getElementById('globalConfirmOverlay').classList.add('active');
            }
        }, true);
    });

    // Sidebar unauthorized clicks ke liye alert function
    function showGlobalAlert(title, message) {
        isAlertMode = true;
        pendingConfirmForm = null;
        document.getElementById('globalConfirmTitle').textContent = title;
        document.getElementById('globalConfirmMessage').textContent = message;
        document.getElementById('globalConfirmOkBtn').textContent = 'OK';
        document.getElementById('globalCancelBtn').style.display = 'none';
        document.getElementById('globalConfirmOverlay').classList.add('active');
    }

    function executeGlobalConfirm() {
        document.getElementById('globalConfirmOverlay').classList.remove('active');
        if (isAlertMode) {
            isAlertMode = false;
            return;
        }
        if (pendingConfirmForm) {
            const targetForm = pendingConfirmForm;
            pendingConfirmForm = null;
            targetForm.removeAttribute('data-confirm');
            HTMLFormElement.prototype.submit.call(targetForm);
        }
    }

    function cancelGlobalConfirm() {
        document.getElementById('globalConfirmOverlay').classList.remove('active');
        pendingConfirmForm = null;
        isAlertMode = false;
    }
</script>