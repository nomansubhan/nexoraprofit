<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>My Information - Nexora Capital</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #050817;
            background-image: radial-gradient(ellipse at 50% 18%, rgba(27, 69, 112, .28), transparent 42%),
                radial-gradient(ellipse at 20% 75%, rgba(219, 49, 119, .12), transparent 35%),
                radial-gradient(ellipse at 85% 88%, rgba(25, 113, 184, .14), transparent 38%);
            color: #f1f5ff;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .mobile-frame {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: linear-gradient(180deg, rgba(8, 14, 31, .98), rgba(5, 9, 23, .98));
            padding: 20px 16px 40px;
            position: relative;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(115, 199, 255, .08);
            border-right: 1px solid rgba(115, 199, 255, .08);
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-bottom: 24px;
        }

        .back-btn {
            position: absolute;
            left: 0;
            width: 38px;
            height: 38px;
            background: rgba(8, 18, 39, .85);
            border: 1.5px solid #72e8ff;
            border-radius: 50%;
            display: grid;
            place-items: center;
            color: #8ff1ff;
            text-decoration: none;
            font-size: 14px;
            box-shadow: 0 0 16px rgba(68, 213, 255, .13);
        }

        .title {
            font-size: 20px;
            font-weight: 900;
            color: #eaf7ff;
            text-shadow: 0 0 12px rgba(91, 202, 255, .35);
        }

        .info-card {
            background: linear-gradient(145deg, rgba(23, 34, 59, .96), rgba(10, 17, 36, .96));
            border: 1.5px solid rgba(185, 218, 255, .4);
            border-radius: 28px;
            padding: 22px 18px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.15);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            font-weight: 700;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 12px;
        }

        .info-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .info-row span:first-child {
            color: #b7c4d9;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
        }

        .info-row span:last-child {
            color: #f8fafc;
            font-weight: 800;
        }
    </style>
</head>

<body>
    <div class="mobile-frame">
        <div class="header">
            <a href="/profile" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="title">My Information</div>
        </div>

        <div class="info-card">
            <div class="info-row">
                <span>Username</span>
                <span>
                    <%= user.username %>
                </span>
            </div>
            <div class="info-row">
                <span>Phone / Mobile</span>
                <span>
                    <%= user.phone || 'N/A' %>
                </span>
            </div>
            <div class="info-row">
                <span>Account Balance</span>
                <span style="color: #ff5c77; text-shadow: 0 0 10px rgba(255, 92, 119, 0.4);">Rs <%= user.balance ?
                        user.balance.toFixed(0) : 0 %></span>
            </div>
            <div class="info-row">
                <span>Total Investment</span>
                <span style="color: #34d399; text-shadow: 0 0 10px rgba(52, 211, 153, 0.4);">Rs <%= user.totalInvestment
                        ? user.totalInvestment.toFixed(0) : 0 %></span>
            </div>
            <div class="info-row">
                <span>Referred By</span>
                <span>
                    <%= user.referredBy || 'Direct Registration' %>
                </span>
            </div>
            <div class="info-row">
                <span>Account Status</span>
                <span style="color: #34d399;"><i class="fa-solid fa-circle-check" style="margin-right: 4px;"></i> Active
                    / Verified</span>
            </div>
        </div>
    </div>
</body>

</html>