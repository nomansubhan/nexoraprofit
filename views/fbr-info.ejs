<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>FBR & SECP Info - Nexora Capital</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #050817;
            background-image: radial-gradient(ellipse at 50% 18%, rgba(27, 69, 112, .28), transparent 42%),
                radial-gradient(ellipse at 20% 75%, rgba(219, 49, 119, .12), transparent 35%),
                radial-gradient(ellipse at 85% 88%, rgba(25, 113, 184, .14), transparent 38%);
            color: #f1f5ff;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .mobile-frame {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: linear-gradient(180deg, rgba(8, 14, 31, .98), rgba(5, 9, 23, .98));
            padding: 20px 16px 40px;
            position: relative;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(115, 199, 255, .08);
            border-right: 1px solid rgba(115, 199, 255, .08);
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-bottom: 20px;
        }

        .back-btn {
            position: absolute;
            left: 0;
            width: 38px;
            height: 38px;
            background: rgba(8, 18, 39, .85);
            border: 1.5px solid #72e8ff;
            border-radius: 50%;
            display: grid;
            place-items: center;
            color: #8ff1ff;
            text-decoration: none;
            font-size: 14px;
            box-shadow: 0 0 16px rgba(68, 213, 255, .13);
        }

        .title {
            font-size: 18px;
            font-weight: 900;
            color: #eaf7ff;
            text-shadow: 0 0 12px rgba(91, 202, 255, .35);
        }

        .doc-section {
            background: linear-gradient(145deg, rgba(23, 34, 59, .96), rgba(10, 17, 36, .96));
            border: 1.5px solid rgba(185, 218, 255, .4);
            border-radius: 28px;
            padding: 20px 16px;
            margin-bottom: 18px;
            text-align: center;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.15);
        }

        .doc-section h3 {
            font-size: 15px;
            font-weight: 900;
            color: #f8fafc;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
        }

        .doc-section img {
            width: 100%;
            border-radius: 14px;
            border: 1px solid rgba(187, 220, 255, .3);
            object-fit: contain;
            background: #0b1120;
            box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>

<body>
    <div class="mobile-frame">
        <div class="header">
            <a href="/profile" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="title">FBR & SECP Documents</div>
        </div>

        <!-- FBR Document Image -->
        <div class="doc-section">
            <h3><i class="fa-solid fa-file-shield" style="color: #34d399;"></i> FBR Certificate</h3>
            <% if (locals.setting && setting.fbrCertificate) { %>
                <img src="<%= setting.fbrCertificate %>" alt="FBR Certificate">[cite: 19]
                <% } else { %>
                    <p style="font-size: 12px; color: #94a3b8; padding: 20px 0; font-weight: 600;">FBR Certificate image
                        jald update ki jayegi.</p>[cite: 19]
                    <% } %>
        </div>

        <!-- SECP Document Image -->
        <div class="doc-section">
            <h3><i class="fa-solid fa-certificate" style="color: #38bdf8;"></i> SECP Certificate</h3>
            <% if (locals.setting && setting.secpCertificate) { %>
                <img src="<%= setting.secpCertificate %>" alt="SECP Certificate">[cite: 19]
                <% } else { %>
                    <p style="font-size: 12px; color: #94a3b8; padding: 20px 0; font-weight: 600;">SECP Certificate
                        image jald update ki jayegi.</p>[cite: 19]
                    <% } %>
        </div>
    </div>
</body>

</html>