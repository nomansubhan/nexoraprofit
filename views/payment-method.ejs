<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>Select Payment Method - Nexora Capital</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #050817;
            background-image: radial-gradient(ellipse at 50% 18%, rgba(27, 69, 112, .28), transparent 42%),
                radial-gradient(ellipse at 20% 75%, rgba(219, 49, 119, .12), transparent 35%),
                radial-gradient(ellipse at 85% 88%, rgba(25, 113, 184, .14), transparent 38%);
            color: #f1f5ff;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .mobile-frame {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: linear-gradient(180deg, rgba(8, 14, 31, .98), rgba(5, 9, 23, .98));
            padding: 20px 16px 40px;
            position: relative;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(115, 199, 255, .08);
            border-right: 1px solid rgba(115, 199, 255, .08);
        }

        .screen-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .back-btn {
            font-size: 16px;
            color: #8ff1ff;
            text-decoration: none;
            width: 38px;
            height: 38px;
            background: rgba(8, 18, 39, .85);
            border: 1.5px solid #72e8ff;
            border-radius: 50%;
            display: grid;
            place-items: center;
            box-shadow: 0 0 16px rgba(68, 213, 255, .13);
        }

        .header-title {
            font-size: 20px;
            font-weight: 900;
            color: #eaf7ff;
            text-shadow: 0 0 12px rgba(91, 202, 255, .35);
        }

        .bank-card-item {
            background: linear-gradient(145deg, rgba(23, 34, 59, .96), rgba(10, 17, 36, .96));
            border: 1.5px solid rgba(185, 218, 255, .4);
            border-radius: 20px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: #f8fafc;
            margin-bottom: 14px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
            transition: all 0.2s ease;
        }

        .bank-card-item:active {
            transform: scale(0.98);
        }

        .bank-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .bank-logo {
            width: 44px;
            height: 44px;
            object-fit: contain;
            border-radius: 12px;
            border: 1px solid rgba(187, 220, 255, .3);
            padding: 4px;
            background: #ffffff;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .bank-info strong {
            font-size: 15px;
            font-weight: 800;
            display: block;
            color: #f8fafc;
        }

        .bank-info small {
            font-size: 11px;
            color: #b7c4d9;
            font-weight: 600;
        }

        .chevron {
            color: #14b8a6;
            font-size: 14px;
            font-weight: 900;
        }
    </style>
</head>

<body>
    <div class="mobile-frame">
        <div class="screen-header">
            <a href="/invest" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <h2 class="header-title">Select Gateway</h2>
        </div>

        <p style="font-size:12px; color:#b7c4d9; margin-bottom:18px; font-weight: 600;">
            Package <%= pkg.id %> — <strong style="color: #ff5c77; text-shadow: 0 0 10px rgba(255, 92, 119, 0.4);">Rs.
                    <%= pkg.price %>
                </strong> deposit karne ke liye payment method select karein:
        </p>

        <% if (activeBanks.length===0) { %>
            <div
                style="background: linear-gradient(145deg, rgba(23, 34, 59, .7), rgba(10, 17, 36, .85)); border: 2px dashed rgba(185, 218, 255, .3); border-radius: 20px; padding: 30px; text-align: center; color: #94a3b8; font-size: 13px; font-weight: 600;">
                Filhal koi payment method active nahi hai. Barah-e-karam baad mein koshish karein.
            </div>
            <% } %>

                <% activeBanks.forEach(b=> { %>
                    <a href="/payment-details/<%= pkg.id %>?bankId=<%= b._id %>" class="bank-card-item">
                        <div class="bank-left">
                            <img src="<%= b.logo %>" class="bank-logo" alt="<%= b.bankName %>"
                                onerror="this.src='/assets/Easypaisa-logo.png'">
                            <div class="bank-info">
                                <strong>
                                    <%= b.bankName %>
                                </strong>
                                <small>
                                    <%= b.accountTitle %>
                                </small>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right chevron"></i>
                    </a>
                    <% }) %>
    </div>
</body>

</html>