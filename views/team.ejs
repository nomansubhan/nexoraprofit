<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>My Team - Nexora Capital</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #050817;
            background-image: radial-gradient(ellipse at 50% 18%, rgba(27, 69, 112, .28), transparent 42%),
                radial-gradient(ellipse at 20% 75%, rgba(219, 49, 119, .12), transparent 35%),
                radial-gradient(ellipse at 85% 88%, rgba(25, 113, 184, .14), transparent 38%);
            color: #f1f5ff;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .mobile-frame {
            width: 100%;
            max-width: 420px;
            min-height: 100vh;
            background: linear-gradient(180deg, rgba(8, 14, 31, .98), rgba(5, 9, 23, .98));
            padding: 20px 16px 40px;
            position: relative;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8);
            border-left: 1px solid rgba(115, 199, 255, .08);
            border-right: 1px solid rgba(115, 199, 255, .08);
        }

        .history-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .back-btn {
            width: 38px;
            height: 38px;
            background: rgba(8, 18, 39, .85);
            border: 1.5px solid #72e8ff;
            border-radius: 50%;
            display: grid;
            place-items: center;
            color: #8ff1ff;
            text-decoration: none;
            font-size: 14px;
            box-shadow: 0 0 16px rgba(68, 213, 255, .13);
        }

        .history-title {
            font-size: 20px;
            font-weight: 900;
            color: #eaf7ff;
            text-align: center;
            line-height: 1.1;
            text-shadow: 0 0 12px rgba(91, 202, 255, .35);
        }

        .summary-card {
            background: linear-gradient(145deg, rgba(23, 34, 59, .96), rgba(10, 17, 36, .96));
            border: 1.5px solid rgba(185, 218, 255, .4);
            border-radius: 28px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 12px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.15);
        }

        .summary-icon {
            width: 52px;
            height: 52px;
            background: rgba(20, 184, 166, 0.2);
            color: #34d399;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 22px;
            border: 1px solid rgba(20, 184, 166, 0.4);
        }

        .summary-info small {
            font-size: 11px;
            font-weight: 700;
            color: #b7c4d9;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .summary-info h2 {
            font-size: 28px;
            font-weight: 900;
            color: #ff5c77;
            line-height: 1.1;
            text-shadow: 0 0 20px rgba(255, 92, 119, 0.4);
        }

        .summary-info p {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 600;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-box {
            background: linear-gradient(145deg, rgba(23, 34, 59, .8), rgba(10, 17, 36, .9));
            border: 1.5px solid rgba(185, 218, 255, .25);
            border-radius: 20px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .stat-icon {
            width: 38px;
            height: 38px;
            background: rgba(20, 184, 166, 0.2);
            color: #34d399;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 15px;
            border: 1px solid rgba(20, 184, 166, 0.4);
        }

        .stat-box span {
            display: block;
            font-size: 16px;
            font-weight: 900;
            color: #f8fafc;
        }

        .stat-box small {
            font-size: 10px;
            color: #b7c4d9;
            font-weight: 700;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 900;
            color: #eaf7ff;
        }

        .badge-members {
            background: rgba(20, 184, 166, 0.2);
            color: #34d399;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 12px;
            border: 1px solid rgba(20, 184, 166, 0.4);
        }

        .levels-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 24px;
        }

        .level-card {
            background: linear-gradient(145deg, rgba(23, 34, 59, .8), rgba(10, 17, 36, .9));
            border: 1.5px solid rgba(185, 218, 255, .25);
            border-radius: 18px;
            padding: 14px 16px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .level-card small {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #b7c4d9;
            margin-bottom: 4px;
        }

        .level-card span {
            font-size: 20px;
            font-weight: 900;
            color: #f8fafc;
        }

        .empty-state {
            background: linear-gradient(145deg, rgba(23, 34, 59, .7), rgba(10, 17, 36, .85));
            border: 2px dashed rgba(185, 218, 255, .3);
            border-radius: 24px;
            padding: 30px 20px;
            text-align: center;
            margin-top: 10px;
        }

        .empty-icon {
            width: 60px;
            height: 60px;
            background: rgba(20, 184, 166, 0.2);
            color: #34d399;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 24px;
            margin: 0 auto 14px;
            border: 1px solid rgba(20, 184, 166, 0.4);
        }

        .empty-state h3 {
            font-size: 15px;
            font-weight: 800;
            color: #f8fafc;
            margin-bottom: 4px;
        }

        .empty-state p {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="mobile-frame">
        <div class="history-header">
            <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i></a>
            <div class="history-title">Referral<br>History</div>
            <div style="width: 38px;"></div>
        </div>

        <!-- Total Team Members Card -->
        <div class="summary-card">
            <div class="summary-icon"><i class="fa-solid fa-users"></i></div>
            <div class="summary-info">
                <small>Total Team Members</small>
                <h2>
                    <%= (typeof totalMembers !=='undefined' ) ? totalMembers : 0 %>
                </h2>
                <p>Build your network and unlock more rewards.</p>
            </div>
        </div>

        <!-- Investment & Commission Stats Grid -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-icon"><i class="fa-solid fa-wallet"></i></div>
                <div>
                    <small>Team Investment</small>
                    <span>Rs <%= (typeof teamInvestment !=='undefined' ) ? teamInvestment : 0 %></span>
                </div>
            </div>
            <div class="stat-box">
                <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
                <div>
                    <small>Referral Commission</small>
                    <span>Rs <%= (typeof referralCommission !=='undefined' ) ? referralCommission : 0 %></span>
                </div>
            </div>
        </div>

        <!-- Team Levels Header -->
        <div class="section-header">
            <div class="section-title">Team Levels</div>
            <div class="badge-members">
                <%= (typeof totalMembers !=='undefined' ) ? totalMembers : 0 %> members
            </div>
        </div>

        <!-- Team Levels Cards -->
        <div class="levels-grid">
            <div class="level-card">
                <small>All Team</small>
                <span>
                    <%= (typeof totalMembers !=='undefined' ) ? totalMembers : 0 %>
                </span>
            </div>
            <div class="level-card">
                <small>Level 1</small>
                <span>
                    <%= (typeof level1Count !=='undefined' ) ? level1Count : 0 %>
                </span>
            </div>
        </div>

        <!-- Team Members Section -->
        <div class="section-header">
            <div class="section-title">Team Members</div>
            <i class="fa-solid fa-users" style="color: #34d399; font-size: 18px;"></i>
        </div>

        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-users"></i></div>
            <h3>No team members yet</h3>
            <p>Invite friends to start building your team.</p>
        </div>

    </div>

</body>

</html>