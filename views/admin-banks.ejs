<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, viewport-fit=cover">
    <title>Currency Accounts - Nexora Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #e5e7eb;
            color: #1e293b;
            min-height: 100vh;
        }

        .admin-main-content {
            margin-left: 250px;
            padding: 24px 28px;
            min-height: 100vh;
        }

        .page-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .title-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .back-circle-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #1d4ed8;
            color: #ffffff;
            display: grid;
            place-items: center;
            text-decoration: none;
            font-size: 15px;
            box-shadow: 0 4px 10px rgba(29, 78, 216, 0.25);
        }

        .page-title {
            font-size: 18px;
            font-weight: 900;
            color: #0f172a;
        }

        .btn-plus-add {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #008069;
            color: #ffffff;
            display: grid;
            place-items: center;
            font-size: 18px;
            text-decoration: none;
            box-shadow: 0 4px 12px rgba(0, 128, 105, 0.3);
            border: none;
            cursor: pointer;
        }

        .filters-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 18px;
        }

        .filter-tab {
            padding: 9px 12px;
            border-radius: 20px;
            text-align: center;
            font-size: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            border: none;
            outline: none;
            transition: all 0.2s ease;
        }

        .filter-tab.all {
            background: #2563eb;
            color: #ffffff;
        }

        .filter-tab.active-tab {
            background: #dcfce7;
            color: #166534;
        }

        .filter-tab.disabled-tab {
            background: #ffe4e6;
            color: #9f1239;
        }

        .account-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 16px 18px;
            margin-bottom: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #f1f5f9;
        }

        .acc-info-left h3 {
            font-size: 15px;
            font-weight: 900;
            color: #0f172a;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .status-badge {
            background: #dcfce7;
            color: #16a34a;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 8px;
        }

        .status-badge.off {
            background: #fee2e2;
            color: #dc2626;
        }

        .acc-meta {
            margin-top: 5px;
            font-size: 12px;
            color: #475569;
        }

        .acc-meta strong {
            color: #0f172a;
        }

        .acc-number-text {
            color: #0284c7;
            font-weight: 800;
        }

        .acc-actions-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-status-toggle {
            background: #008069;
            color: #ffffff;
            border: none;
            padding: 7px 16px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
        }

        .btn-status-toggle.enable {
            background: #1d4ed8;
        }

        .btn-delete-icon {
            background: #ffe4e6;
            color: #e11d48;
            border: none;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 13px;
            cursor: pointer;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 10000;
            place-items: center;
            padding: 16px;
        }

        .modal-overlay.active {
            display: grid;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 18px;
            width: 100%;
            max-width: 420px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .modal-card h3 {
            font-size: 16px;
            font-weight: 900;
            margin-bottom: 14px;
        }

        .input-group {
            margin-bottom: 10px;
        }

        .input-group label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .input-group input,
        .input-group select {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            outline: none;
            background: #f8fafc;
        }

        @media (max-width: 768px) {
            .admin-main-content {
                margin-left: 0;
                padding: 68px 12px 80px;
            }

            .page-title {
                font-size: 15px;
            }

            .filters-row {
                grid-template-columns: repeat(3, 1fr);
                gap: 6px;
            }

            .filter-tab {
                padding: 7px 6px;
                font-size: 10px;
            }

            .account-card {
                padding: 12px 14px;
                border-radius: 14px;
            }
        }
    </style>
</head>

<body>

    <%- include('admin-sidebar') %>

        <main class="admin-main-content">
            <%- include('admin-header') %>

                <div class="page-header-bar">
                    <div class="title-left">
                        <a href="/admin/dashboard" class="back-circle-btn"><i class="fa-solid fa-arrow-left"></i></a>
                        <h1 class="page-title">Currency Accounts</h1>
                    </div>
                    <button class="btn-plus-add" onclick="openAddModal()"><i class="fa-solid fa-plus"></i></button>
                </div>

                <div class="filters-row">
                    <button class="filter-tab all" onclick="filterBanks('all')"><i
                            class="fa-solid fa-table-cells"></i><span>All <%= banks.length %></span></button>
                    <button class="filter-tab active-tab" onclick="filterBanks('active')"><i
                            class="fa-solid fa-check"></i><span>Active <%= banks.filter(b=> b.isActive).length
                                %></span></button>
                    <button class="filter-tab disabled-tab" onclick="filterBanks('disabled')"><i
                            class="fa-solid fa-ban"></i><span>Disabled <%= banks.filter(b=> !b.isActive).length
                                %></span></button>
                </div>

                <div id="accountsContainer">
                    <% if (banks.length===0) { %>
                        <div
                            style="background:#fff; border-radius:16px; padding:30px; text-align:center; color:#64748b; font-size:12px;">
                            No accounts found. Click <strong>(+)</strong> to add one.
                        </div>
                        <% } %>

                            <% banks.forEach(bank=> { %>
                                <div class="account-card" data-status="<%= bank.isActive ? 'active' : 'disabled' %>">
                                    <div class="acc-info-left">
                                        <h3>
                                            <%= bank.bankName %>
                                                <span class="status-badge <%= bank.isActive ? '' : 'off' %>">
                                                    <%= bank.isActive ? 'Active' : 'Disabled' %>
                                                </span>
                                        </h3>
                                        <div class="acc-meta">Title: <strong>
                                                <%= bank.accountTitle %>
                                            </strong></div>
                                        <div class="acc-meta">Number: <span class="acc-number-text">
                                                <%= bank.accountNumber %>
                                            </span></div>
                                    </div>
                                    <div class="acc-actions-right">
                                        <form action="/admin/banks/toggle/<%= bank._id %>" method="POST"
                                            style="display:inline;">
                                            <button type="submit"
                                                class="btn-status-toggle <%= bank.isActive ? '' : 'enable' %>">
                                                <%= bank.isActive ? 'Disable' : 'Enable' %>
                                            </button>
                                        </form>
                                        <form action="/admin/banks/delete/<%= bank._id %>" method="POST"
                                            style="display:inline;"
                                            data-confirm="Are you sure you want to remove <%= bank.bankName %> account?"
                                            data-confirm-title="Delete Currency Account?" data-confirm-btn="Delete">
                                            <button type="submit" class="btn-delete-icon"><i
                                                    class="fa-solid fa-trash-can"></i></button>
                                        </form>
                                    </div>
                                </div>
                                <% }) %>
                </div>
        </main>

        <div class="modal-overlay" id="addBankModal">
            <div class="modal-card">
                <h3>Add Currency Account</h3>
                <form action="/admin/banks/add" method="POST">
                    <div class="input-group">
                        <label>Select Bank / Wallet</label>
                        <select name="bankName" required>
                            <% availableBanks.forEach(b=> { %>
                                <option value="<%= b.name %>">
                                    <%= b.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="input-group">
                        <label>Account Title</label>
                        <input type="text" name="accountTitle" placeholder="e.g. Noman Subhan" required>
                    </div>
                    <div class="input-group">
                        <label>Account / Mobile Number</label>
                        <input type="text" name="accountNumber" placeholder="03XXXXXXXXX" required>
                    </div>
                
                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:14px;">
                        <button type="button" onclick="closeAddModal()"
                            style="background:#e2e8f0; border:none; padding:8px 14px; border-radius:10px; font-weight:700; font-size:11px; cursor:pointer;">Cancel</button>
                        <button type="submit"
                            style="background:#008069; color:#fff; border:none; padding:8px 18px; border-radius:10px; font-weight:800; font-size:11px; cursor:pointer;">Save
                            Account</button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            function openAddModal() { document.getElementById('addBankModal').classList.add('active'); }
            function closeAddModal() { document.getElementById('addBankModal').classList.remove('active'); }
            function filterBanks(type) {
                const cards = document.querySelectorAll('.account-card');
                cards.forEach(card => {
                    const status = card.getAttribute('data-status');
                    if (type === 'all' || status === type) { card.style.display = 'flex'; } else { card.style.display = 'none'; }
                });
            }
        </script>

</body>

</html>